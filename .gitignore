secrets/
.env
etc/letsencrypt/
node_modules/

# Environments
.envrc
.venv
venv/

# Python (repo started as Python template)
__pycache__/
*.py[codz]
*.egg-info/
.ipynb_checkpoints

# App repos in repos/ are independent clones — the clone itself is ignored,
# but hosting additions for vtracer (Dockerfile, nginx.conf, 404 page) are
# tracked via exception rules below.
repos/*/
!repos/vtracer/
!repos/vtracer/*
repos/vtracer/webapp/target/
repos/vtracer/webapp/app/pkg/
repos/vtracer/webapp/app/node_modules/
repos/vtracer/webapp/app/dist/
repos/vtracer/webapp/pkg/